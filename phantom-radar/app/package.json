{
  "name": "phantom-radar",
  "version": "1.0.0",
  "description": "Phantom Radar",
  "main": "main.js",
  "author": "Adwaita",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@stoprocent/noble": "latest"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.adwaita.phantomradar",
    "productName": "Phantom Radar",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Phantom-Radar-Setup.${ext}",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "identity": null,
      "category": "public.app-category.utilities",
      "artifactName": "Phantom-Radar-${arch}.${ext}",
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Phantom Radar scans for nearby Bluetooth devices.",
        "NSBluetoothPeripheralUsageDescription": "Phantom Radar scans for nearby Bluetooth devices."
      },
      "icon": "build/icon.png"
    }
  }
}